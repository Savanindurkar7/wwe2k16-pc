+// --- WWE 2K16 Android: the driver's pipeline cache on disk -------------------------------------------------------
+
+void VulkanPipelineCache::LoadDriverPipelineCache(const std::filesystem::path& shader_storage_root) {
+  if (driver_pipeline_cache_ != VK_NULL_HANDLE || !REXCVAR_GET(vulkan_pipeline_cache)) {
+    return;
+  }
+  const ui::vulkan::VulkanDevice* const vulkan_device = command_processor_.GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  const auto& properties = vulkan_device->properties();
+  driver_pipeline_cache_path_ = shader_storage_root / "vk_pipeline_cache.bin";
+
+  // Only data this driver wrote is handed back: some phone drivers crash on another driver's cache (after a driver
+  // update, or with a custom driver chosen), so the header is checked here rather than trusting the driver to.
+  std::vector<uint8_t> data;
+  if (FILE* file = rex::filesystem::OpenFile(driver_pipeline_cache_path_, "rb")) {
+    std::fseek(file, 0, SEEK_END);
+    const long size = std::ftell(file);
+    std::fseek(file, 0, SEEK_SET);
+    if (size > 0 && size < (long(1) << 30)) {
+      data.resize(size_t(size));
+      if (std::fread(data.data(), 1, data.size(), file) != data.size()) data.clear();
+    }
+    std::fclose(file);
+  }
+  const char* origin = "new";
+  if (!data.empty()) {
+    VkPipelineCacheHeaderVersionOne header = {};
+    bool valid = data.size() >= sizeof(header);
+    if (valid) {
+      std::memcpy(&header, data.data(), sizeof(header));
+      valid = header.headerSize >= sizeof(header) && header.headerVersion == VK_PIPELINE_CACHE_HEADER_VERSION_ONE &&
+              header.vendorID == properties.vendorID && header.deviceID == properties.deviceID &&
+              std::memcmp(header.pipelineCacheUUID, properties.pipelineCacheUUID, VK_UUID_SIZE) == 0;
+    }
+    if (valid) {
+      origin = "loaded";
+    } else {
+      REXGPU_INFO("VulkanPipelineCache: the stored driver pipeline cache is from another driver or GPU, starting a new one");
+      data.clear();
+      origin = "replaced";
+    }
+  }
+  VkPipelineCacheCreateInfo create_info = {VK_STRUCTURE_TYPE_PIPELINE_CACHE_CREATE_INFO};
+  create_info.initialDataSize = data.size();
+  create_info.pInitialData = data.empty() ? nullptr : data.data();
+  if (dfn.vkCreatePipelineCache(device, &create_info, nullptr, &driver_pipeline_cache_) != VK_SUCCESS) {
+    driver_pipeline_cache_ = VK_NULL_HANDLE;
+    if (!data.empty()) {
+      // A cache the driver refuses: start empty.
+      create_info.initialDataSize = 0;
+      create_info.pInitialData = nullptr;
+      if (dfn.vkCreatePipelineCache(device, &create_info, nullptr, &driver_pipeline_cache_) != VK_SUCCESS) {
+        driver_pipeline_cache_ = VK_NULL_HANDLE;
+      }
+    }
+  }
+  driver_pipeline_cache_unsaved_.store(0, std::memory_order_relaxed);
+  driver_pipeline_cache_last_save_ = std::chrono::steady_clock::now();
+  REXGPU_INFO("VulkanPipelineCache: driver pipeline cache {} ({} KB) at {}",
+              driver_pipeline_cache_ != VK_NULL_HANDLE ? origin : "unavailable", data.size() / 1024,
+              rex::path_to_utf8(driver_pipeline_cache_path_));
+}
+
+void VulkanPipelineCache::SaveDriverPipelineCache(const char* reason) {
+  if (driver_pipeline_cache_ == VK_NULL_HANDLE || driver_pipeline_cache_path_.empty()) {
+    return;
+  }
+  std::lock_guard<std::mutex> lock(driver_pipeline_cache_save_lock_);
+  const uint32_t unsaved = driver_pipeline_cache_unsaved_.exchange(0, std::memory_order_relaxed);
+  driver_pipeline_cache_last_save_ = std::chrono::steady_clock::now();
+  if (!unsaved) {
+    return;
+  }
+  const ui::vulkan::VulkanDevice* const vulkan_device = command_processor_.GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  size_t size = 0;
+  if (dfn.vkGetPipelineCacheData(device, driver_pipeline_cache_, &size, nullptr) != VK_SUCCESS || !size) {
+    return;
+  }
+  std::vector<uint8_t> data(size);
+  if (dfn.vkGetPipelineCacheData(device, driver_pipeline_cache_, &size, data.data()) != VK_SUCCESS) {
+    return;
+  }
+  data.resize(size);
+  // Written to a temporary file and renamed: a killed app never leaves half a cache behind.
+  std::filesystem::path temp_path = driver_pipeline_cache_path_;
+  temp_path += ".tmp";
+  FILE* file = rex::filesystem::OpenFile(temp_path, "wb");
+  if (!file) {
+    return;
+  }
+  const bool written = std::fwrite(data.data(), 1, data.size(), file) == data.size();
+  std::fclose(file);
+  std::error_code ec;
+  if (written) {
+    std::filesystem::rename(temp_path, driver_pipeline_cache_path_, ec);
+  }
+  if (!written || ec) {
+    std::filesystem::remove(temp_path, ec);
+    return;
+  }
+  REXGPU_INFO("VulkanPipelineCache: driver pipeline cache saved ({}, {} new pipelines, {} KB)", reason, unsaved,
+              data.size() / 1024);
+}
+
+void VulkanPipelineCache::DestroyDriverPipelineCache() {
+  if (driver_pipeline_cache_ == VK_NULL_HANDLE) {
+    return;
+  }
+  SaveDriverPipelineCache("exit");
+  const ui::vulkan::VulkanDevice* const vulkan_device = command_processor_.GetVulkanDevice();
+  vulkan_device->functions().vkDestroyPipelineCache(vulkan_device->device(), driver_pipeline_cache_, nullptr);
+  driver_pipeline_cache_ = VK_NULL_HANDLE;
+}
