diff --git a/include/rex/perf/stall_counters.h b/include/rex/perf/stall_counters.h
new file mode 100644
index 0000000..1392d6c
--- /dev/null
+++ b/include/rex/perf/stall_counters.h
@@ -0,0 +1,54 @@
+/**
+ * @file        perf/stall_counters.h
+ * @brief       WWE 2K16 Android: running totals the game reads per frame to tell what a long frame spent its time on
+ *              (pipeline creation, texture loads, guest file reads). Relaxed atomics: cheap, read as deltas.
+ */
+#pragma once
+
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+
+namespace rex::perf {
+
+struct StallCounters {
+  std::atomic<uint64_t> pipelines_created{0};
+  std::atomic<uint64_t> pipeline_create_ns{0};
+  std::atomic<uint64_t> pipeline_cache_hits{0};   // pipelines created from the driver's on-disk cache (fast)
+  std::atomic<uint64_t> texture_loads{0};
+  std::atomic<uint64_t> texture_load_ns{0};
+  std::atomic<uint64_t> file_reads{0};
+  std::atomic<uint64_t> file_read_bytes{0};
+  std::atomic<uint64_t> file_read_ns{0};
+};
+
+inline StallCounters& GetStallCounters() {
+  static StallCounters counters;
+  return counters;
+}
+
+inline uint64_t StallNowNs() {
+  return uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                      std::chrono::steady_clock::now().time_since_epoch())
+                      .count());
+}
+
+// Adds the time from construction to destruction to `ns` (and 1 to `count`, if given).
+class StallScope {
+ public:
+  StallScope(std::atomic<uint64_t>& ns, std::atomic<uint64_t>* count = nullptr)
+      : ns_(ns), count_(count), start_(StallNowNs()) {}
+  ~StallScope() {
+    ns_.fetch_add(StallNowNs() - start_, std::memory_order_relaxed);
+    if (count_) count_->fetch_add(1, std::memory_order_relaxed);
+  }
+  StallScope(const StallScope&) = delete;
+  StallScope& operator=(const StallScope&) = delete;
+
+ private:
+  std::atomic<uint64_t>& ns_;
+  std::atomic<uint64_t>* count_;
+  uint64_t start_;
+};
+
+}  // namespace rex::perf
