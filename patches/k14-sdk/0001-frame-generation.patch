+bool VulkanPresenter::FrameGenInitialize() {
+  FrameGen& fg = frame_gen_;
+  if (fg.init_tried) return fg.init_ok;
+  fg.init_tried = true;
+  const VulkanDevice::Functions& dfn = vulkan_device_->functions();
+  const VkDevice device = vulkan_device_->device();
+
+  const struct {
+    const uint32_t* code;
+    size_t bytes;
+  } module_code[4] = {
+      {fg_shaders::frame_gen_downsample_comp, sizeof(fg_shaders::frame_gen_downsample_comp)},
+      {fg_shaders::frame_gen_motion_comp, sizeof(fg_shaders::frame_gen_motion_comp)},
+      {fg_shaders::frame_gen_fullscreen_vert, sizeof(fg_shaders::frame_gen_fullscreen_vert)},
+      {fg_shaders::frame_gen_interpolate_frag, sizeof(fg_shaders::frame_gen_interpolate_frag)},
+  };
+  for (uint32_t i = 0; i < 4; ++i) {
+    VkShaderModuleCreateInfo info = {VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO};
+    info.codeSize = module_code[i].bytes;
+    info.pCode = module_code[i].code;
+    if (dfn.vkCreateShaderModule(device, &info, nullptr, &fg.modules[i]) != VK_SUCCESS) {
+      REXLOG_ERROR("[framegen] shader module {} could not be created: off", i);
+      return false;
+    }
+  }
+
+  // Set layouts: compute (0, 1 sampled + sampler, 2 storage), graphics (0, 1, 2 sampled + sampler).
+  const VkSampler linear =
+      ui_samplers_->samplers()[UISamplers::kSamplerIndexLinearClampToEdge];
+  const VkSampler nearest =
+      ui_samplers_->samplers()[UISamplers::kSamplerIndexNearestClampToEdge];
+  {
+    VkSampler samplers_linear[2] = {linear, linear};
+    VkDescriptorSetLayoutBinding bindings[3] = {};
+    for (uint32_t i = 0; i < 2; ++i) {
+      bindings[i].binding = i;
+      bindings[i].descriptorType = VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER;
+      bindings[i].descriptorCount = 1;
+      bindings[i].stageFlags = VK_SHADER_STAGE_COMPUTE_BIT;
+      bindings[i].pImmutableSamplers = &samplers_linear[i];
+    }
+    bindings[2].binding = 2;
+    bindings[2].descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_IMAGE;
+    bindings[2].descriptorCount = 1;
+    bindings[2].stageFlags = VK_SHADER_STAGE_COMPUTE_BIT;
+    VkDescriptorSetLayoutCreateInfo info = {VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO};
+    info.bindingCount = 3;
+    info.pBindings = bindings;
+    if (dfn.vkCreateDescriptorSetLayout(device, &info, nullptr, &fg.compute_set_layout) != VK_SUCCESS) {
+      REXLOG_ERROR("[framegen] compute descriptor set layout failed: off");
+      return false;
+    }
+  }
+  {
+    // 0 previous, 1 current: linear; 2 vectors: nearest (texelFetch ignores it, but a sampler is needed).
+    VkSampler samplers[3] = {linear, linear, nearest};
+    VkDescriptorSetLayoutBinding bindings[3] = {};
+    for (uint32_t i = 0; i < 3; ++i) {
+      bindings[i].binding = i;
+      bindings[i].descriptorType = VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER;
+      bindings[i].descriptorCount = 1;
+      bindings[i].stageFlags = VK_SHADER_STAGE_FRAGMENT_BIT;
+      bindings[i].pImmutableSamplers = &samplers[i];
+    }
+    VkDescriptorSetLayoutCreateInfo info = {VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO};
+    info.bindingCount = 3;
+    info.pBindings = bindings;
+    if (dfn.vkCreateDescriptorSetLayout(device, &info, nullptr, &fg.graphics_set_layout) != VK_SUCCESS) {
+      REXLOG_ERROR("[framegen] graphics descriptor set layout failed: off");
+      return false;
+    }
+  }
+  // Pipeline layouts.
+  const auto make_layout = [&](VkDescriptorSetLayout set_layout, VkShaderStageFlags stages, uint32_t constants,
+                               VkPipelineLayout& out) {
+    VkPushConstantRange range = {stages, 0, constants};
+    VkPipelineLayoutCreateInfo info = {VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO};
+    info.setLayoutCount = 1;
+    info.pSetLayouts = &set_layout;
+    info.pushConstantRangeCount = 1;
+    info.pPushConstantRanges = &range;
+    return dfn.vkCreatePipelineLayout(device, &info, nullptr, &out) == VK_SUCCESS;
+  };
+  if (!make_layout(fg.compute_set_layout, VK_SHADER_STAGE_COMPUTE_BIT, sizeof(DownsampleConstants),
+                   fg.downsample_layout) ||
+      !make_layout(fg.compute_set_layout, VK_SHADER_STAGE_COMPUTE_BIT, sizeof(MotionConstants), fg.motion_layout) ||
+      !make_layout(fg.graphics_set_layout, VK_SHADER_STAGE_FRAGMENT_BIT, sizeof(InterpolateConstants),
+                   fg.interpolate_layout)) {
+    REXLOG_ERROR("[framegen] pipeline layouts failed: off");
+    return false;
+  }
+  // Compute pipelines.
+  const auto make_compute = [&](VkShaderModule module, VkPipelineLayout layout, VkPipeline& out) {
+    VkComputePipelineCreateInfo info = {VK_STRUCTURE_TYPE_COMPUTE_PIPELINE_CREATE_INFO};
+    info.stage.sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO;
+    info.stage.stage = VK_SHADER_STAGE_COMPUTE_BIT;
+    info.stage.module = module;
+    info.stage.pName = "main";
+    info.layout = layout;
+    return dfn.vkCreateComputePipelines(device, VK_NULL_HANDLE, 1, &info, nullptr, &out) == VK_SUCCESS;
+  };
+  if (!make_compute(fg.modules[0], fg.downsample_layout, fg.downsample_pipeline) ||
+      !make_compute(fg.modules[1], fg.motion_layout, fg.motion_pipeline)) {
+    REXLOG_ERROR("[framegen] compute pipelines failed: off");
+    return false;
+  }
+  // The interpolation pipeline: the guest output intermediate render pass (same image format, shader read > colour
+  // attachment > shader read), dynamic viewport and scissor.
+  {
+    VkPipelineShaderStageCreateInfo stages[2] = {};
+    for (uint32_t i = 0; i < 2; ++i) {
+      stages[i].sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO;
+      stages[i].stage = i ? VK_SHADER_STAGE_FRAGMENT_BIT : VK_SHADER_STAGE_VERTEX_BIT;
+      stages[i].module = fg.modules[i ? 3 : 2];
+      stages[i].pName = "main";
+    }
+    VkPipelineVertexInputStateCreateInfo vertex_input = {VK_STRUCTURE_TYPE_PIPELINE_VERTEX_INPUT_STATE_CREATE_INFO};
+    VkPipelineInputAssemblyStateCreateInfo input_assembly = {
+        VK_STRUCTURE_TYPE_PIPELINE_INPUT_ASSEMBLY_STATE_CREATE_INFO};
+    input_assembly.topology = VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST;
+    VkPipelineViewportStateCreateInfo viewport = {VK_STRUCTURE_TYPE_PIPELINE_VIEWPORT_STATE_CREATE_INFO};
+    viewport.viewportCount = 1;
+    viewport.scissorCount = 1;
+    VkPipelineRasterizationStateCreateInfo raster = {VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_STATE_CREATE_INFO};
+    raster.polygonMode = VK_POLYGON_MODE_FILL;
+    raster.cullMode = VK_CULL_MODE_NONE;
+    raster.frontFace = VK_FRONT_FACE_CLOCKWISE;
+    raster.lineWidth = 1.0f;
+    VkPipelineMultisampleStateCreateInfo multisample = {VK_STRUCTURE_TYPE_PIPELINE_MULTISAMPLE_STATE_CREATE_INFO};
+    multisample.rasterizationSamples = VK_SAMPLE_COUNT_1_BIT;
+    VkPipelineColorBlendAttachmentState blend_attachment = {};
+    blend_attachment.colorWriteMask =
+        VK_COLOR_COMPONENT_R_BIT | VK_COLOR_COMPONENT_G_BIT | VK_COLOR_COMPONENT_B_BIT | VK_COLOR_COMPONENT_A_BIT;
+    VkPipelineColorBlendStateCreateInfo blend = {VK_STRUCTURE_TYPE_PIPELINE_COLOR_BLEND_STATE_CREATE_INFO};
+    blend.attachmentCount = 1;
+    blend.pAttachments = &blend_attachment;
+    const VkDynamicState dynamic_states[2] = {VK_DYNAMIC_STATE_VIEWPORT, VK_DYNAMIC_STATE_SCISSOR};
+    VkPipelineDynamicStateCreateInfo dynamic = {VK_STRUCTURE_TYPE_PIPELINE_DYNAMIC_STATE_CREATE_INFO};
+    dynamic.dynamicStateCount = 2;
+    dynamic.pDynamicStates = dynamic_states;
+    VkGraphicsPipelineCreateInfo info = {VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO};
+    info.stageCount = 2;
+    info.pStages = stages;
+    info.pVertexInputState = &vertex_input;
+    info.pInputAssemblyState = &input_assembly;
+    info.pViewportState = &viewport;
+    info.pRasterizationState = &raster;
+    info.pMultisampleState = &multisample;
+    info.pColorBlendState = &blend;
+    info.pDynamicState = &dynamic;
+    info.layout = fg.interpolate_layout;
+    info.renderPass = guest_output_intermediate_render_pass_;
+    info.subpass = 0;
+    if (dfn.vkCreateGraphicsPipelines(device, VK_NULL_HANDLE, 1, &info, nullptr, &fg.interpolate_pipeline) !=
+        VK_SUCCESS) {
+      REXLOG_ERROR("[framegen] interpolation pipeline failed: off");
+      return false;
+    }
+  }
+  // Descriptor pool: per slot and entry a downsample (compute), an interpolation and a copy set (graphics); one
+  // motion set.
+  {
+    constexpr uint32_t kEntrySets = 2 * FrameGen::kSetEntries;
+    VkDescriptorPoolSize sizes[2] = {
+        {VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, kEntrySets * (2 + 3 + 3) + 2},
+        {VK_DESCRIPTOR_TYPE_STORAGE_IMAGE, kEntrySets + 1},
+    };
+    VkDescriptorPoolCreateInfo info = {VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO};
+    info.maxSets = kEntrySets * 3 + 1;
+    info.poolSizeCount = 2;
+    info.pPoolSizes = sizes;
+    if (dfn.vkCreateDescriptorPool(device, &info, nullptr, &fg.descriptor_pool) != VK_SUCCESS) {
+      REXLOG_ERROR("[framegen] descriptor pool failed: off");
+      return false;
+    }
+    const auto allocate = [&](VkDescriptorSetLayout layout, VkDescriptorSet& out) {
+      VkDescriptorSetAllocateInfo alloc = {VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO};
+      alloc.descriptorPool = fg.descriptor_pool;
+      alloc.descriptorSetCount = 1;
+      alloc.pSetLayouts = &layout;
+      return dfn.vkAllocateDescriptorSets(device, &alloc, &out) == VK_SUCCESS;
+    };
+    bool ok = allocate(fg.compute_set_layout, fg.motion_set);
+    for (uint32_t slot = 0; slot < 2 && ok; ++slot) {
+      for (uint32_t e = 0; e < FrameGen::kSetEntries && ok; ++e) {
+        FrameGen::SetEntry& entry = fg.set_entries[slot][e];
+        ok = allocate(fg.compute_set_layout, entry.downsample) && allocate(fg.graphics_set_layout, entry.interpolate) &&
+             allocate(fg.graphics_set_layout, entry.copy);
+      }
+    }
+    if (!ok) {
+      REXLOG_ERROR("[framegen] descriptor sets failed: off");
+      return false;
+    }
+  }
+  fg.init_ok = true;
+  REXLOG_INFO("[framegen] ready (motion search at a quarter of the size, 16x16 pixel blocks)");
+  return true;
+}
+
+void VulkanPresenter::FrameGenDestroySized() {
+  FrameGen& fg = frame_gen_;
+  const VulkanDevice::Functions& dfn = vulkan_device_->functions();
+  const VkDevice device = vulkan_device_->device();
+  for (uint32_t i = 0; i < 2; ++i) {
+    util::DestroyAndNullHandle(dfn.vkDestroyFramebuffer, device, fg.history_framebuffers[i]);
+    fg.history[i].reset();
+    for (FrameGen::SetEntry& entry : fg.set_entries[i]) entry.current = nullptr;
+  }
+  util::DestroyAndNullHandle(dfn.vkDestroyFramebuffer, device, fg.output_framebuffer);
+  fg.output.reset();
+  util::DestroyAndNullHandle(dfn.vkDestroyImageView, device, fg.luma_view);
+  util::DestroyAndNullHandle(dfn.vkDestroyImage, device, fg.luma_image);
+  util::DestroyAndNullHandle(dfn.vkFreeMemory, device, fg.luma_memory);
+  util::DestroyAndNullHandle(dfn.vkDestroyImageView, device, fg.vector_view);
+  util::DestroyAndNullHandle(dfn.vkDestroyImage, device, fg.vector_image);
+  util::DestroyAndNullHandle(dfn.vkFreeMemory, device, fg.vector_memory);
+  fg.width = 0;
+  fg.height = 0;
+  fg.images_in_general = false;
+  fg.history_slot = -1;
+  fg.pending_real = false;
+}
+
+void VulkanPresenter::FrameGenShutdown() {
+  FrameGen& fg = frame_gen_;
+  if (!fg.init_tried) return;
+  const VulkanDevice::Functions& dfn = vulkan_device_->functions();
+  const VkDevice device = vulkan_device_->device();
+  // The caller has awaited the paint submissions.
+  FrameGenDestroySized();
+  util::DestroyAndNullHandle(dfn.vkDestroyDescriptorPool, device, fg.descriptor_pool);
+  util::DestroyAndNullHandle(dfn.vkDestroyPipeline, device, fg.interpolate_pipeline);
+  util::DestroyAndNullHandle(dfn.vkDestroyPipeline, device, fg.motion_pipeline);
+  util::DestroyAndNullHandle(dfn.vkDestroyPipeline, device, fg.downsample_pipeline);
+  util::DestroyAndNullHandle(dfn.vkDestroyPipelineLayout, device, fg.interpolate_layout);
+  util::DestroyAndNullHandle(dfn.vkDestroyPipelineLayout, device, fg.motion_layout);
+  util::DestroyAndNullHandle(dfn.vkDestroyPipelineLayout, device, fg.downsample_layout);
+  util::DestroyAndNullHandle(dfn.vkDestroyDescriptorSetLayout, device, fg.graphics_set_layout);
+  util::DestroyAndNullHandle(dfn.vkDestroyDescriptorSetLayout, device, fg.compute_set_layout);
+  for (VkShaderModule& module : fg.modules) {
+    util::DestroyAndNullHandle(dfn.vkDestroyShaderModule, device, module);
+  }
+  fg = FrameGen();
+}
+
+bool VulkanPresenter::FrameGenEnsureSize(uint32_t width, uint32_t height) {
+  FrameGen& fg = frame_gen_;
+  if (fg.width == width && fg.height == height && fg.output) return true;
+  // The per-size objects may still be used by queued paints.
+  paint_context_.submission_tracker.AwaitSubmissionCompletion(fg.sized_last_submission);
+  FrameGenDestroySized();
+  const VulkanDevice::Functions& dfn = vulkan_device_->functions();
+  const VkDevice device = vulkan_device_->device();
+
+  const auto make_target = [&](std::shared_ptr<GuestOutputImage>& image, VkFramebuffer& framebuffer) {
+    std::unique_ptr<GuestOutputImage> created = GuestOutputImage::Create(vulkan_device_, width, height);
+    if (!created) return false;
+    image = std::move(created);
+    VkImageView view = image->view();
+    VkFramebufferCreateInfo info = {VK_STRUCTURE_TYPE_FRAMEBUFFER_CREATE_INFO};
+    info.renderPass = guest_output_intermediate_render_pass_;
+    info.attachmentCount = 1;
+    info.pAttachments = &view;
+    info.width = width;
+    info.height = height;
+    info.layers = 1;
+    return dfn.vkCreateFramebuffer(device, &info, nullptr, &framebuffer) == VK_SUCCESS;
+  };
+  const auto make_storage = [&](uint32_t w, uint32_t h, VkImage& image, VkDeviceMemory& memory, VkImageView& view) {
+    VkImageCreateInfo info = {VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO};
+    info.imageType = VK_IMAGE_TYPE_2D;
+    info.format = VK_FORMAT_R16G16B16A16_SFLOAT;  // storage support is required for this format
+    info.extent = {w, h, 1};
+    info.mipLevels = 1;
+    info.arrayLayers = 1;
+    info.samples = VK_SAMPLE_COUNT_1_BIT;
+    info.tiling = VK_IMAGE_TILING_OPTIMAL;
+    info.usage = VK_IMAGE_USAGE_STORAGE_BIT | VK_IMAGE_USAGE_SAMPLED_BIT;
+    info.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+    info.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+    if (!util::CreateDedicatedAllocationImage(vulkan_device_, info, util::MemoryPurpose::kDeviceLocal, image,
+                                              memory)) {
+      return false;
+    }
+    VkImageViewCreateInfo view_info = {VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO};
+    view_info.image = image;
+    view_info.viewType = VK_IMAGE_VIEW_TYPE_2D;
+    view_info.format = info.format;
+    view_info.subresourceRange = util::InitializeSubresourceRange();
+    return dfn.vkCreateImageView(device, &view_info, nullptr, &view) == VK_SUCCESS;
+  };
+  const uint32_t luma_w = std::max(1u, (width + 3) / 4), luma_h = std::max(1u, (height + 3) / 4);
+  const uint32_t vector_w = std::max(1u, (luma_w + 3) / 4), vector_h = std::max(1u, (luma_h + 3) / 4);
+  if (!make_target(fg.history[0], fg.history_framebuffers[0]) ||
+      !make_target(fg.history[1], fg.history_framebuffers[1]) || !make_target(fg.output, fg.output_framebuffer) ||
+      !make_storage(luma_w, luma_h, fg.luma_image, fg.luma_memory, fg.luma_view) ||
+      !make_storage(vector_w, vector_h, fg.vector_image, fg.vector_memory, fg.vector_view)) {
+    REXLOG_ERROR("[framegen] images for {}x{} could not be created: no in-between frames", width, height);
+    FrameGenDestroySized();
+    return false;
+  }
+  fg.width = width;
+  fg.height = height;
+  // Motion set: luma (sampled, binding 0; binding 1 unused but valid), vectors (storage, binding 2).
+  {
+    VkDescriptorImageInfo luma_sampled = {VK_NULL_HANDLE, fg.luma_view, VK_IMAGE_LAYOUT_GENERAL};
+    VkDescriptorImageInfo vector_storage = {VK_NULL_HANDLE, fg.vector_view, VK_IMAGE_LAYOUT_GENERAL};
+    VkWriteDescriptorSet writes[3] = {};
+    for (uint32_t i = 0; i < 3; ++i) {
+      writes[i].sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
+      writes[i].dstSet = fg.motion_set;
+      writes[i].dstBinding = i;
+      writes[i].descriptorCount = 1;
+      writes[i].descriptorType = i == 2 ? VK_DESCRIPTOR_TYPE_STORAGE_IMAGE : VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER;
+      writes[i].pImageInfo = i == 2 ? &vector_storage : &luma_sampled;
+    }
+    dfn.vkUpdateDescriptorSets(device, 3, writes, 0, nullptr);
+  }
+  REXLOG_INFO("[framegen] {}x{}: luma {}x{}, vectors {}x{}", width, height, luma_w, luma_h, vector_w, vector_h);
+  return true;
+}
+
+std::shared_ptr<VulkanPresenter::GuestOutputImage> VulkanPresenter::FrameGenProcess(
+    VkCommandBuffer command_buffer, const std::shared_ptr<GuestOutputImage>& current, uint64_t refresh_seq,
+    uint64_t paint_submission) {
+  FrameGen& fg = frame_gen_;
+  if (!current) return nullptr;
+  if (!REXCVAR_GET(present_frame_generation)) {
+    if (fg.history_slot >= 0) {
+      fg.history_slot = -1;
+      fg.pending_real = false;
+    }
+    return nullptr;
+  }
+  if (!FrameGenInitialize()) return nullptr;
+  const uint64_t now = SteadyNs();
+  const bool is_new = refresh_seq != fg.last_new_seq;
+  if (!is_new) {
+    // The repaint after an in-between frame (or any other repaint): the real frame.
+    fg.pending_real = false;
+    return nullptr;
+  }
+  // A new guest frame.
+  const uint64_t gap = fg.last_new_ns ? now - fg.last_new_ns : 0;
+  fg.last_new_ns = now;
+  fg.last_new_seq = refresh_seq;
+  const uint64_t max_gap = uint64_t(REXCVAR_GET(present_frame_generation_max_gap_ms)) * 1000000ull;
+  if (gap && gap < max_gap) {
+    fg.interval_ns = fg.interval_ns > 0.0 ? fg.interval_ns * 0.85 + double(gap) * 0.15 : double(gap);
+  }
+  const VkExtent2D extent = current->extent();
+  const uint32_t width = extent.width, height = extent.height;
+  if (!FrameGenEnsureSize(width, height)) return nullptr;
+  fg.sized_last_submission = paint_submission;
+
+  const VulkanDevice::Functions& dfn = vulkan_device_->functions();
+  const VkDevice device = vulkan_device_->device();
+
+  // Generate only with a previous frame of this size, a normal gap, and the last real frame already shown.
+  const bool generate = fg.history_slot >= 0 && gap && gap < max_gap && !fg.pending_real;
+  if (!generate && fg.history_slot >= 0) ++fg.skipped;
+  const int prev_slot = fg.history_slot;            // read: the previous real frame
+  const int next_slot = prev_slot >= 0 ? 1 - prev_slot : 0;  // written: the current frame, for next time
+
+  // The descriptor sets for (slot, current): found, or the least recently used entry of the slot rewritten after its
+  // last paint is done.
+  const auto sets_for = [&](int slot) -> FrameGen::SetEntry& {
+    FrameGen::SetEntry* entries = fg.set_entries[slot];
+    FrameGen::SetEntry* entry = nullptr;
+    for (uint32_t e = 0; e < FrameGen::kSetEntries; ++e) {
+      if (entries[e].current == current.get()) {
+        entry = &entries[e];
+        break;
+      }
+    }
+    if (!entry) {
+      entry = &entries[0];
+      for (uint32_t e = 1; e < FrameGen::kSetEntries; ++e) {
+        if (entries[e].last_submission < entry->last_submission) entry = &entries[e];
+      }
+      paint_context_.submission_tracker.AwaitSubmissionCompletion(entry->last_submission);
+      entry->current = current.get();
+      VkDescriptorImageInfo prev_info = {VK_NULL_HANDLE, fg.history[slot]->view(),
+                                         VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL};
+      VkDescriptorImageInfo curr_info = {VK_NULL_HANDLE, current->view(), VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL};
+      VkDescriptorImageInfo luma_storage = {VK_NULL_HANDLE, fg.luma_view, VK_IMAGE_LAYOUT_GENERAL};
+      VkDescriptorImageInfo vectors_info = {VK_NULL_HANDLE, fg.vector_view, VK_IMAGE_LAYOUT_GENERAL};
+      VkWriteDescriptorSet writes[9] = {};
+      const auto set_write = [&](uint32_t i, VkDescriptorSet set, uint32_t binding, VkDescriptorType type,
+                                 const VkDescriptorImageInfo* info) {
+        writes[i].sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
+        writes[i].dstSet = set;
+        writes[i].dstBinding = binding;
+        writes[i].descriptorCount = 1;
+        writes[i].descriptorType = type;
+        writes[i].pImageInfo = info;
+      };
+      set_write(0, entry->downsample, 0, VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, &prev_info);
+      set_write(1, entry->downsample, 1, VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, &curr_info);
+      set_write(2, entry->downsample, 2, VK_DESCRIPTOR_TYPE_STORAGE_IMAGE, &luma_storage);
+      set_write(3, entry->interpolate, 0, VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, &prev_info);
+      set_write(4, entry->interpolate, 1, VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, &curr_info);
+      set_write(5, entry->interpolate, 2, VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, &vectors_info);
+      // The copy reads binding 1 (current); 0 and 2 only need valid images in the right layouts (0 is the current
+      // image too: the history image of this slot is the copy's own target).
+      set_write(6, entry->copy, 0, VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, &curr_info);
+      set_write(7, entry->copy, 1, VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, &curr_info);
+      set_write(8, entry->copy, 2, VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, &vectors_info);
+      dfn.vkUpdateDescriptorSets(device, 9, writes, 0, nullptr);
+    }
+    entry->last_submission = paint_submission;
+    return *entry;
+  };
+
+  // Everything before (earlier paints sampling or writing these images) is done before this paint's passes.
+  {
+    VkMemoryBarrier barrier = {VK_STRUCTURE_TYPE_MEMORY_BARRIER};
+    barrier.srcAccessMask = VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT |
+                            VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT;
+    barrier.dstAccessMask = VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT |
+                            VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT;
+    dfn.vkCmdPipelineBarrier(command_buffer,
+                             VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT | VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT |
+                                 VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT,
+                             VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT | VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT |
+                                 VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT,
+                             0, 1, &barrier, 0, nullptr, 0, nullptr);
+  }
+  if (!fg.images_in_general) {
+    VkImageMemoryBarrier barriers[2] = {};
+    VkImage images[2] = {fg.luma_image, fg.vector_image};
+    for (uint32_t i = 0; i < 2; ++i) {
+      barriers[i].sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER;
+      barriers[i].srcAccessMask = 0;
+      barriers[i].dstAccessMask = VK_ACCESS_SHADER_WRITE_BIT | VK_ACCESS_SHADER_READ_BIT;
+      barriers[i].oldLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+      barriers[i].newLayout = VK_IMAGE_LAYOUT_GENERAL;
+      barriers[i].srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+      barriers[i].dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+      barriers[i].image = images[i];
+      barriers[i].subresourceRange = util::InitializeSubresourceRange();
+    }
+    dfn.vkCmdPipelineBarrier(command_buffer, VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT,
+                             VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT | VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT, 0, 0,
+                             nullptr, 0, nullptr, 2, barriers);
+    fg.images_in_general = true;
+  }
+
+  const auto run_fullscreen = [&](VkFramebuffer framebuffer, VkDescriptorSet set, int32_t mode) {
+    VkRenderPassBeginInfo begin = {VK_STRUCTURE_TYPE_RENDER_PASS_BEGIN_INFO};
+    begin.renderPass = guest_output_intermediate_render_pass_;
+    begin.framebuffer = framebuffer;
+    begin.renderArea.extent = {width, height};
+    dfn.vkCmdBeginRenderPass(command_buffer, &begin, VK_SUBPASS_CONTENTS_INLINE);
+    VkViewport viewport = {0.0f, 0.0f, float(width), float(height), 0.0f, 1.0f};
+    VkRect2D scissor = {{0, 0}, {width, height}};
+    dfn.vkCmdSetViewport(command_buffer, 0, 1, &viewport);
+    dfn.vkCmdSetScissor(command_buffer, 0, 1, &scissor);
+    dfn.vkCmdBindPipeline(command_buffer, VK_PIPELINE_BIND_POINT_GRAPHICS, fg.interpolate_pipeline);
+    dfn.vkCmdBindDescriptorSets(command_buffer, VK_PIPELINE_BIND_POINT_GRAPHICS, fg.interpolate_layout, 0, 1, &set,
+                                0, nullptr);
+    InterpolateConstants constants = {};
+    constants.size[0] = float(width);
+    constants.size[1] = float(height);
+    constants.vector_size[0] = int32_t(std::max(1u, (std::max(1u, (width + 3) / 4) + 3) / 4));
+    constants.vector_size[1] = int32_t(std::max(1u, (std::max(1u, (height + 3) / 4) + 3) / 4));
+    constants.mode = mode;
+    constants.fallback_low = 0.06f;
+    constants.fallback_high = 0.22f;
+    dfn.vkCmdPushConstants(command_buffer, fg.interpolate_layout, VK_SHADER_STAGE_FRAGMENT_BIT, 0,
+                           sizeof(constants), &constants);
+    dfn.vkCmdDraw(command_buffer, 3, 1, 0, 0);
+    dfn.vkCmdEndRenderPass(command_buffer);
+  };
+
+  std::shared_ptr<GuestOutputImage> result;
+  if (generate) {
+    FrameGen::SetEntry& sets = sets_for(prev_slot);
+    const uint32_t luma_w = std::max(1u, (width + 3) / 4), luma_h = std::max(1u, (height + 3) / 4);
+    const uint32_t vector_w = std::max(1u, (luma_w + 3) / 4), vector_h = std::max(1u, (luma_h + 3) / 4);
+    // 1. Luma pair.
+    dfn.vkCmdBindPipeline(command_buffer, VK_PIPELINE_BIND_POINT_COMPUTE, fg.downsample_pipeline);
+    dfn.vkCmdBindDescriptorSets(command_buffer, VK_PIPELINE_BIND_POINT_COMPUTE, fg.downsample_layout, 0, 1,
+                                &sets.downsample, 0, nullptr);
+    DownsampleConstants downsample = {{int32_t(width), int32_t(height)}, {int32_t(luma_w), int32_t(luma_h)}};
+    dfn.vkCmdPushConstants(command_buffer, fg.downsample_layout, VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof(downsample),
+                           &downsample);
+    dfn.vkCmdDispatch(command_buffer, (luma_w + 7) / 8, (luma_h + 7) / 8, 1);
+    VkMemoryBarrier barrier = {VK_STRUCTURE_TYPE_MEMORY_BARRIER};
+    barrier.srcAccessMask = VK_ACCESS_SHADER_WRITE_BIT;
+    barrier.dstAccessMask = VK_ACCESS_SHADER_READ_BIT;
+    dfn.vkCmdPipelineBarrier(command_buffer, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+                             VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, 0, 1, &barrier, 0, nullptr, 0, nullptr);
+    // 2. Vectors.
+    dfn.vkCmdBindPipeline(command_buffer, VK_PIPELINE_BIND_POINT_COMPUTE, fg.motion_pipeline);
+    dfn.vkCmdBindDescriptorSets(command_buffer, VK_PIPELINE_BIND_POINT_COMPUTE, fg.motion_layout, 0, 1,
+                                &fg.motion_set, 0, nullptr);
+    MotionConstants motion = {};
+    motion.luma_size[0] = int32_t(luma_w);
+    motion.luma_size[1] = int32_t(luma_h);
+    motion.vector_size[0] = int32_t(vector_w);
+    motion.vector_size[1] = int32_t(vector_h);
+    motion.radius = REXCVAR_GET(present_frame_generation_search);
+    motion.length_bias = 0.004f;
+    dfn.vkCmdPushConstants(command_buffer, fg.motion_layout, VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof(motion),
+                           &motion);
+    dfn.vkCmdDispatch(command_buffer, (vector_w + 7) / 8, (vector_h + 7) / 8, 1);
+    dfn.vkCmdPipelineBarrier(command_buffer, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+                             VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT, 0, 1, &barrier, 0, nullptr, 0, nullptr);
+    // 3. The in-between frame.
+    run_fullscreen(fg.output_framebuffer, sets.interpolate, 0);
+    result = fg.output;
+    fg.pending_real = true;
+    ++fg.generated;
+    // The real frame half a frame interval later (a little less: the paint itself takes time).
+    const double half = fg.interval_ns > 0.0 ? fg.interval_ns * 0.5 : 8.0e6;
+    const uint64_t delay = uint64_t(std::clamp(half * 0.92, 2.0e6, 40.0e6));
+    ScheduleFrameGenRepaint(delay);
+  }
+  // 4. The current frame into the other history image (the copy set of `next_slot` reads `current` at binding 1).
+  run_fullscreen(fg.history_framebuffers[next_slot], sets_for(next_slot).copy, 1);
+  fg.history_slot = next_slot;
+  fg.history_seq = refresh_seq;
+
+  const int32_t log_s = REXCVAR_GET(present_frame_generation_log_s);
+  if (log_s > 0) {
+    if (!fg.log_window_start_ns) fg.log_window_start_ns = now;
+    if (now - fg.log_window_start_ns >= uint64_t(log_s) * 1000000000ull) {
+      const double seconds = double(now - fg.log_window_start_ns) / 1.0e9;
+      REXLOG_INFO("[framegen] {:.1f} s: {} in-between frames ({:.1f}/s), {} new frames without one; game frame "
+                  "interval {:.1f} ms",
+                  seconds, fg.generated, double(fg.generated) / seconds, fg.skipped, fg.interval_ns / 1.0e6);
+      fg.generated = 0;
+      fg.skipped = 0;
+      fg.log_window_start_ns = now;
+    }
+  }
+  return result;
+}
