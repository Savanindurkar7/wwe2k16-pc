+++ b/src/ui/shaders/frame_gen_motion.comp
@@ -0,0 +1,59 @@
+#version 450
+// wwe2k16 frame generation, pass 2: one motion vector per 4x4 block of the quarter-size luma (16x16 pixels), searched
+// symmetrically from the in-between frame: the block at c matches the previous frame at c - d and the current one at
+// c + d (the whole motion between the frames is 2d). Coarse search in steps of 2, then +-1 around the best; a small
+// bias to short vectors keeps flat areas still. Output: (d.x, d.y) in quarter-size texels, the match cost, 1.
+layout(local_size_x = 8, local_size_y = 8) in;
+layout(set = 0, binding = 0) uniform sampler2D u_luma;
+layout(set = 0, binding = 1, rgba16f) uniform writeonly image2D u_vectors;
+layout(push_constant) uniform Constants {
+  ivec2 luma_size;
+  ivec2 vector_size;
+  int radius;
+  float length_bias;
+} pc;
+float BlockCost(ivec2 c, ivec2 d) {
+  float s = 0.0;
+  ivec2 hi = pc.luma_size - ivec2(1);
+  for (int y = 0; y < 4; ++y) {
+    for (int x = 0; x < 4; ++x) {
+      ivec2 q = c + ivec2(x, y);
+      float a = texelFetch(u_luma, clamp(q - d, ivec2(0), hi), 0).r;
+      float b = texelFetch(u_luma, clamp(q + d, ivec2(0), hi), 0).g;
+      s += abs(a - b);
+    }
+  }
+  return s;
+}
+void main() {
+  ivec2 blk = ivec2(gl_GlobalInvocationID.xy);
+  if (any(greaterThanEqual(blk, pc.vector_size))) return;
+  ivec2 c = blk * 4;
+  ivec2 best = ivec2(0);
+  float best_cost = BlockCost(c, ivec2(0));
+  int r = pc.radius;
+  for (int dy = -r; dy <= r; dy += 2) {
+    for (int dx = -r; dx <= r; dx += 2) {
+      ivec2 d = ivec2(dx, dy);
+      if (d == ivec2(0)) continue;
+      float cost = BlockCost(c, d) + pc.length_bias * length(vec2(d));
+      if (cost < best_cost) {
+        best_cost = cost;
+        best = d;
+      }
+    }
+  }
+  ivec2 coarse = best;
+  for (int dy = -1; dy <= 1; ++dy) {
+    for (int dx = -1; dx <= 1; ++dx) {
+      ivec2 d = coarse + ivec2(dx, dy);
+      if (d == coarse || abs(d.x) > r + 1 || abs(d.y) > r + 1) continue;
+      float cost = BlockCost(c, d) + pc.length_bias * length(vec2(d));
+      if (cost < best_cost) {
+        best_cost = cost;
+        best = d;
+      }
+    }
+  }
+  imageStore(u_vectors, blk, vec4(vec2(best), best_cost, 1.0));
+}
