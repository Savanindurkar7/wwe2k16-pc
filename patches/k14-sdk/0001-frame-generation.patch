@@ -0,0 +1,45 @@
+#version 450
+// wwe2k16 frame generation, pass 3: the in-between frame. Per pixel, the vectors of its block and the four next to it
+// are tried; each warps the previous frame back and the current frame forward by half the motion, and the pair that
+// agrees best is averaged. Where no vector fits (a disocclusion, a cut, the HUD changing) the two frames are blended
+// as they are. mode 1 = copy the current frame (the history for the next in-between frame).
+layout(location = 0) out vec4 o_color;
+layout(set = 0, binding = 0) uniform sampler2D u_prev;
+layout(set = 0, binding = 1) uniform sampler2D u_curr;
+layout(set = 0, binding = 2) uniform sampler2D u_vectors;
+layout(push_constant) uniform Constants {
+  vec2 size;
+  ivec2 vector_size;
+  int mode;
+  float fallback_low;
+  float fallback_high;
+  float pad;
+} pc;
+void main() {
+  vec2 px = gl_FragCoord.xy;
+  vec2 inv = 1.0 / pc.size;
+  vec2 uv = px * inv;
+  if (pc.mode == 1) {
+    o_color = vec4(textureLod(u_curr, uv, 0.0).rgb, 1.0);
+    return;
+  }
+  ivec2 b = ivec2(px * (1.0 / 16.0));
+  ivec2 hi = pc.vector_size - ivec2(1);
+  const ivec2 kOffsets[5] = ivec2[](ivec2(0, 0), ivec2(1, 0), ivec2(-1, 0), ivec2(0, 1), ivec2(0, -1));
+  vec3 best_color = vec3(0.0);
+  float best_error = 1.0e9;
+  for (int i = 0; i < 5; ++i) {
+    // Quarter-size texels -> pixels: x4.
+    vec2 d = texelFetch(u_vectors, clamp(b + kOffsets[i], ivec2(0), hi), 0).xy * 4.0;
+    vec3 a = textureLod(u_prev, (px - d) * inv, 0.0).rgb;
+    vec3 c = textureLod(u_curr, (px + d) * inv, 0.0).rgb;
+    float e = dot(abs(a - c), vec3(0.3333)) + (i == 0 ? 0.0 : 0.004);
+    if (e < best_error) {
+      best_error = e;
+      best_color = (a + c) * 0.5;
+    }
+  }
+  vec3 blend = 0.5 * (textureLod(u_prev, uv, 0.0).rgb + textureLod(u_curr, uv, 0.0).rgb);
+  float w = smoothstep(pc.fallback_low, pc.fallback_high, best_error);
+  o_color = vec4(mix(best_color, blend, w), 1.0);
+}
