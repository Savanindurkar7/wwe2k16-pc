+#include <rex/cvar.h>
+#include <rex/logging.h>
+#include <rex/ui/vulkan/presenter.h>
+#include <rex/ui/vulkan/util.h>
+
+REXCVAR_DEFINE_BOOL(present_frame_generation, false, "UI/Presenter",
+                    "wwe2k16: an in-between frame (motion-compensated, from the last two guest frames) before each new "
+                    "guest frame, the real one half a frame later: up to twice the frames on a fast screen. Vulkan only")
+    .lifecycle(rex::cvar::Lifecycle::kHotReload);
+REXCVAR_DEFINE_INT32(present_frame_generation_search, 8, "UI/Presenter",
+                     "wwe2k16: the motion search radius in quarter-size texels (the in-between frame's half motion; "
+                     "8 = up to 64 pixels of motion a frame at 720p)")
+    .range(2, 16)
+    .lifecycle(rex::cvar::Lifecycle::kHotReload);
+REXCVAR_DEFINE_INT32(present_frame_generation_max_gap_ms, 80, "UI/Presenter",
+                     "wwe2k16: no in-between frame for guest frames further apart than this (loads, pauses)")
+    .range(20, 500)
+    .lifecycle(rex::cvar::Lifecycle::kHotReload);
+REXCVAR_DEFINE_INT32(present_frame_generation_log_s, 10, "UI/Presenter",
+                     "wwe2k16: a [framegen] line every N seconds (0 = none)")
+    .range(0, 3600)
+    .lifecycle(rex::cvar::Lifecycle::kHotReload);
