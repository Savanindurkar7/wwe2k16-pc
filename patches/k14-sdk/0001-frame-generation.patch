+#version 450
+// wwe2k16 frame generation, pass 1: the previous and the current frame's luma at a quarter of the size (each texel the
+// average of a 4x4 block, from four bilinear taps), packed as (previous, current) for the motion search.
+layout(local_size_x = 8, local_size_y = 8) in;
+layout(set = 0, binding = 0) uniform sampler2D u_prev;
+layout(set = 0, binding = 1) uniform sampler2D u_curr;
+layout(set = 0, binding = 2, rgba16f) uniform writeonly image2D u_luma;
+layout(push_constant) uniform Constants {
+  ivec2 src_size;
+  ivec2 dst_size;
+} pc;
+float Luma(vec3 c) { return dot(c, vec3(0.299, 0.587, 0.114)); }
+void main() {
+  ivec2 p = ivec2(gl_GlobalInvocationID.xy);
+  if (any(greaterThanEqual(p, pc.dst_size))) return;
+  vec2 inv = 1.0 / vec2(pc.src_size);
+  vec2 base = vec2(p * 4);
+  float a = 0.0, b = 0.0;
+  for (int y = 0; y < 2; ++y) {
+    for (int x = 0; x < 2; ++x) {
+      vec2 uv = (base + vec2(float(x * 2 + 1), float(y * 2 + 1))) * inv;
+      a += Luma(textureLod(u_prev, uv, 0.0).rgb);
+      b += Luma(textureLod(u_curr, uv, 0.0).rgb);
+    }
+  }
+  imageStore(u_luma, p, vec4(a * 0.25, b * 0.25, 0.0, 1.0));
+}
