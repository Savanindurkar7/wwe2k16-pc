 }
 
+// wwe2k16 patch (0007): guest names are bytes, not UTF-8. WWE 2K16 opens its DLC under root names made of raw bytes
+// ('pB\xNN0'); the SDK's path and case-folding code (utf8 iterators) threw 'Invalid UTF-8' on them, so the DLC never
+// mounted and the game said "The downloadable content was not loaded properly". A name that is not valid UTF-8 is
+// read as Latin-1 (each byte 0x80-0xFF becomes its 2-byte UTF-8 character): the same mapping everywhere a guest name
+// enters (content root names, file paths), so a root and the paths into it still match. Valid UTF-8 is unchanged.
+inline bool IsValidUtf8(std::string_view s) {
+  size_t i = 0;
+  while (i < s.size()) {
+    const unsigned char c = static_cast<unsigned char>(s[i]);
+    size_t n;
+    if (c < 0x80) n = 0;
+    else if (c >= 0xC2 && c <= 0xDF) n = 1;
+    else if (c >= 0xE0 && c <= 0xEF) n = 2;
+    else if (c >= 0xF0 && c <= 0xF4) n = 3;
+    else return false;
+    if (i + n >= s.size() && n) return false;
+    for (size_t k = 1; k <= n; ++k) {
+      if ((static_cast<unsigned char>(s[i + k]) & 0xC0) != 0x80) return false;
+    }
+    i += n + 1;
+  }
+  return true;
+}
+
+inline std::string GuestNameToUtf8(std::string_view s) {
+  if (IsValidUtf8(s)) return std::string(s);
+  std::string out;
+  out.reserve(s.size() * 2);
+  for (char ch : s) {
+    const unsigned char c = static_cast<unsigned char>(ch);
+    if (c < 0x80) {
+      out.push_back(ch);
+    } else {
+      out.push_back(static_cast<char>(0xC0 | (c >> 6)));
+      out.push_back(static_cast<char>(0x80 | (c & 0x3F)));
+    }
+  }
+  return out;
+}
+
 inline std::string TranslateAnsiPath(const memory::Memory* memory,
                                      const X_ANSI_STRING* ansi_string) {
-  return rex::string::trim_string(std::string(TranslateAnsiString(memory, ansi_string)));
+  return rex::string::trim_string(GuestNameToUtf8(TranslateAnsiString(memory, ansi_string)));
 }
 
